pipeline {
    agent any
    environment {
         // ============================================================
         // Project paths
         // ============================================================
         APP_DIR = 'app'
         TF_DIR = 'terraform-infra'

         // ============================================================
         // Docker registry settings
         // ============================================================
         DOCKER_REGISTRY = 'zhoupan970810'
         APP_NAME = 'sudoku-game'
         DOCKER_IMAGE = "${DOCKER_REGISTRY}/${APP_NAME}"

         // ============================================================
         // Version file location
         // ============================================================
         VERSION_FILE = "${APP_DIR}/version.py"
    }

    stages {
        // ============================================================
        // Stage 1: Checkout Code
        // ============================================================
        stage("Checkout"){
            checkout scm
            script {
                 // Get short commit SHA for tagging
                 env.GIT_COMMIT_SHORT = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                 echo "Commit SHA: ${env.GIT_COMMIT_SHORT}"
            }
        }
        // ============================================================
        // Stage 2: Read Version
        // ============================================================
        stage("Read Version"){
            steps{
                script{
                    dir(env.APP_DIR) {
                        // Read version from version.py
                        env.APP_VERSION = sh(returnStdout: true, script: "python -c 'from version import __version__; print(__version__)'").trim()
                        echo "Current version: ${env.APP_VERSION}"
                    }
                }
            }
        }
        // ============================================================
        // Stage 3: Build Docker Image
        // ============================================================
        stage("Build Docker Image"){
            steps{
                script{
                    dir(env.APP_DIR) {
                        sh """
                            echo "=== Building Docker image ==="
                            docker build -t ${env.DOCKER_IMAGE}:${env.APP_VERSION}
                            docker tag ${env.DOCKER_IMAGE}:${env.APP_VERSION} ${env.DOCKER_IMAGE}:latest

                            echo "Successfully built image: ${env.DOCKER_IMAGE}:${env.APP_VERSION}!"
                        """
                    }
                }
            }
        }
        // ============================================================
        // Stage 4: Push Docker Image to Registry
        // ============================================================
        stage("Push Docker Image"){
            steps{
                script{
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        dir(env.APP_DIR) {
                            sh """
                                echo "=== Logging in to Docker Hub ==="
                                echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin

                                echo "=== Pushing Docker Image ==="
                                docker push ${env.DOCKER_IMAGE}:${env.APP_VERSION}
                                docker push ${env.DOCKER_IMAGE}:latest
                                echo "Successfully pushed Docker Image!"
                            """
                        }
                    }
                }
            }
        }
        // ============================================================
        // Stage 5: Deploy Infrastructure
        // ============================================================
        stage("Deploy Infrastructure"){
            steps{
                script{
                    dir(env.TF_DIR){
                        sh """
                            echo "=== Terraform Init ==="
                            terrafrom init

                            echo "=== Terraform Plan ==="
                            terraform plan

                            echo "=== Terraform Apply ==="
                            terraform apply -auto-approve
                            echo "Infrastructure deployed successfully"
                        """
                    }
                }
            }
        }
        // ============================================================
        // Stage 6: Verify and Deploy Application
        // ============================================================
        stage("Deploy Application"){
            steps{
                script{
                    // Get the public IP from Terraform Output
                    def publicIp = sh(returnStdout: true, script: "cd ${env.TF_DIR} && terraform output -json | jq -r '.vm_public_ip.value' 2>/dev/null || echo 'N/A'").trim()
                    env.VM_IP = publicIp
                    echo "VM Public IP: ${env.VM_IP}"

                    // Wait for VM to be fully ready
                    echo "=== Waiting for VM to be ready (60 seconds) ==="
                    sh 'sleep 60'

                    // Check if Docker is installed on the VM
                    sh """
                        echo "=== Checking Docker Installation ==="
                        ssh -o StrictHostKeyChecking=no zhou@${env.VM_IP} 'docker --version' || {
                            echo "Docker not installed or VM not ready. Please check the VM."
                            exit 1
                        }
                        echo "Docker is installed on the VM!"
                    """

                    // Login to Docker Hub from the VM
                    withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh """
                            echo "=== Logging in to Docker Hub from the VM ==="
                            ssh -o StrictHostKeyChecking=no zhou@${env.VM_IP} "echo '${DOCKER_PASS}' | docker login -u '${DOCKER_USER}' --password-stdin"
                            echo "✅ Docker login successful on the VM!"
                        """
                    }

                    // Pull and run the container on the VM
                    sh """
                        echo "=== Pulling Docker image on the VM ==="
                        ssh -o StrictHostKeyChecking=no zhou@${env.VM_IP} "docker pull ${env.DOCKER_IMAGE}:${env.APP_VERSION}"
                        echo "Image pulled successfully!"

                        echo "=== Stopping and removing any existing container ==="
                        ssh -o StrictHostKeyChecking=no zhou@${env.VM_IP} "docker stop sudoku-app 2>/dev/null || true"
                        ssh -o StrictHostKeyChecking=no zhou@${env.VM_IP} "docker rm sudoku-app 2>/dev/null || true"

                        echo "=== Running the container on the VM ==="
                        ssh -o StrictHostKeyChecking=no zhou@${env.VM_IP} "docker run -d -p 5000:5000 --name sudoku-app --restart unless-stopped ${env.DOCKER_IMAGE}:${env.APP_VERSION}"
                        echo "Container is running on the VM!"
                    """
                }
            }
        }
    }
}